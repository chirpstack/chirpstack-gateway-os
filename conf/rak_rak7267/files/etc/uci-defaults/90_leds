# The Wi-Fi LED follows the radio (on while it is up, blinking with traffic)
# rather than a single interface, because the interface name depends on the
# Wi-Fi mode: the default setup AP creates phy0-ap0, client mode phy0-sta0.
uci -q batch << EOI
set system.led_wifi_led.sysfs='mediatek:orange:wifi'
set system.led_wifi_led.trigger='phy0tpt'
delete system.led_wifi_led.dev
delete system.led_wifi_led.mode

set system.led_eth_led.sysfs='rak:green:eth'
set system.led_eth_led.trigger='netdev'
set system.led_eth_led.dev='eth0.1'

delete system.led_eth_led.mode
add_list system.led_eth_led.mode='link'
add_list system.led_eth_led.mode='tx'
add_list system.led_eth_led.mode='rx' 
EOI
uci commit system
